# Aevia — environment variables (sættes i Vercel → Project → Settings → Environment Variables)
# Kopiér ALDRIG rigtige nøgler ind i denne fil — den er kun dokumentation.

# --- AI-chat (api/chat.js) — vælg ÉN af de to udbydere ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Valgfri model-override (default: gpt-4o-mini / claude-3-5-haiku-latest)
AEVC_MODEL=

# --- Stripe checkout (api/checkout.js) ---
STRIPE_SECRET_KEY=
# Valgfri: fast base-URL til redirects (ellers udledes fra request)
SITE_URL=https://aevia.dk
# Valgfri: automatisk momsberegning i Stripe ("true"/"false")
STRIPE_ENABLE_TAX=false
