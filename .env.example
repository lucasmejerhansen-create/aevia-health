# Aevia — environment variables (sættes i Vercel → Project → Settings → Environment Variables)
# Kopiér ALDRIG rigtige nøgler ind i denne fil — den er kun dokumentation.

# --- AI-chat (api/chat.js) — vælg ÉN af de to udbydere ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Valgfri model-override (default: gpt-4o-mini / claude-3-5-haiku-latest)
AEVC_MODEL=

# --- Stripe checkout (api/checkout.js) ---
STRIPE_SECRET_KEY=
# Valgfri: fast base-URL til redirects (ellers udledes fra request)
SITE_URL=https://aevia.dk
# Valgfri: automatisk momsberegning i Stripe ("true"/"false")
STRIPE_ENABLE_TAX=false

# --- Klinik-bekræftelsessystem (api/booking.js + api/booking-action.js) ---
# Hemmelig nøgle til signering af bekræftelses-links (vælg en lang tilfældig streng)
BOOKING_SECRET=
# Klinik-kontakter pr. område (JSON). Uden denne går alt til kontakt@aevia.dk.
# Eksempel: {"Aarhus-området":"lab@klinik.dk","_default":"kontakt@aevia.dk"}
CLINIC_CONTACTS=
# Mails sendes via Resend (samme nøgle som webhook): RESEND_API_KEY + MAIL_FROM

# --- Velkomst-mailserie (api/lead.js + api/drip.js) ---
# Resend Audience til lead-lagring: resend.com → Audiences → opret "Aevia leads" → kopiér ID
RESEND_AUDIENCE_ID=
# Beskytter cron-endpointet /api/drip (Vercel Cron sender selv "Authorization: Bearer <CRON_SECRET>")
# Vælg en lang tilfældig streng. Afmeld-links signeres med BOOKING_SECRET (findes allerede).
CRON_SECRET=

# --- Cal.com-webhook (api/cal-webhook.js) — straks-bekræftede klinik-bookinger ---
# Samme secret indtastes i Cal.com: Settings → Developer → Webhooks (på hver konto
# der hoster klinik-events). Vælg en lang tilfældig streng.
CAL_WEBHOOK_SECRET=
